# Configuración del servidor. Copia este archivo a `.env` y ajústalo.
# En desarrollo local NO hace falta: sin AUTH_BASE la app arranca abierta,
# como siempre, y `npm run dev` sigue funcionando igual.

# Puerto del proceso. En el servidor lo fija el servicio (3008).
PORT=3001

# Interfaz de escucha. Con AUTH_BASE definida, por defecto es 127.0.0.1 para
# que solo se llegue a través de nginx. No lo pongas en 0.0.0.0 en producción.
# HOST=127.0.0.1

# ─── Sesión compartida con GANDK Control ─────────────────────────────────────
# Origen de la API de la plataforma de Seguimiento, que es quien tiene los
# usuarios y firma la cookie. Definirla ACTIVA la autenticación.
# AUTH_BASE=http://127.0.0.1:3007

# Rol exigido para entrar. Solo los usuarios con este rol ven la liquidación.
# ROL=Liquidacion
